{
  "name": "aracne",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "npm run validate && expo start",
    "web": "npm run validate && expo start --web",
    "android": "npm run validate && expo start --android",
    "ios": "npm run validate && expo start --ios",
    "validate": "tsx scripts/validate.ts",
    "build": "npm run validate && expo export -p web && node scripts/og.mjs",
    "serve": "expo serve",
    "capture": "node scripts/capture.mjs",
    "spider": "node scripts/optimize-spider.mjs",
    "assets": "node scripts/generate-assets.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "sprites": "node scripts/sprites.mjs",
    "atlas": "node scripts/atlas.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo/metro-runtime": "~57.0.7",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.8",
    "expo-font": "~57.0.4",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "three": "^0.185.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.2",
    "@types/three": "^0.185.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "meshoptimizer": "^1.2.0",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
